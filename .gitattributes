# Normalise text in the repository; files that run inside Linux containers must stay LF on Windows checkouts.
* text=auto

*.sh text eol=lf
/.githooks/* text eol=lf
/mvnw text eol=lf
/.mvn/wrapper/maven-wrapper.properties text eol=lf
**/Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.java text eol=lf
*.json text eol=lf
.env.example text eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jar binary
*.gz binary

# Collapsed in GitHub diffs and left out of language statistics.
/transform/uv.lock linguist-generated=true
/transform/package-lock.yml linguist-generated=true
/mvnw linguist-generated=true
/mvnw.cmd linguist-generated=true
