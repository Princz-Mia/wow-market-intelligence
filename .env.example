# Template only. Copy to .env and fill in; .env is never committed.

# Battle.net API client (create one at https://develop.battle.net/access/clients).
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# PostgreSQL. Roles are created once, on an empty data volume; changing these later needs a volume reset.
POSTGRES_PASSWORD=change-me
COLLECTOR_DB_PASSWORD=change-me
TRANSFORMER_DB_PASSWORD=change-me
BI_READER_DB_PASSWORD=change-me

# Host port, bound to 127.0.0.1.
POSTGRES_HOST_PORT=15432
